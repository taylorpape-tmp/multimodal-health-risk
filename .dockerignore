# Keep the build context small and secret-free.

# Version control + CI
.git
.github
.gitignore

# Data — never ship raw data into the image. The demo image needs the two
# small cleaned omics matrices, so those are allowed back in below.
data/*
!data/interim
data/interim/*
!data/interim/omics_S8_sspg_clean.csv
!data/interim/omics_S9_isir_clean.csv
*.zip

# Infra + docs aren't needed at runtime
infra/
docs/
scripts/

# Python caches / build artifacts
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.venv/
venv/

# Tests aren't part of the serving image
tests/

# Local env / secrets / OS cruft
.env
*.tfvars
.DS_Store
**/.DS_Store
